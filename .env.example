# Salin berkas ini menjadi .env lalu sesuaikan untuk lingkungan lokal.
# Jangan menyimpan .env atau rahasia apa pun di repositori.
PORT=3000
SEED_FILE=seed/seed.json
# Tanggal "hari ini" untuk demo (YYYY-MM-DD). Kosongkan untuk memakai tanggal berjalan (Asia/Jakarta).
DEMO_TODAY=2026-10-27
# Sumber referensi karyawan: seed (mock) atau f2 (API Kelompok 2, API-K02-17).
EMPLOYEE_SOURCE=seed
F2_BASE_URL=http://localhost:8080
# Token simulasi yang diterima layanan Kelompok 2 (bukan rahasia; tertulis di repositori F-2).
F2_TOKEN=token-coo
F2_TIMEOUT_MS=3000
